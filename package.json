{
  "name": "@liangdacheng/dsh-vision-bridge",
  "version": "0.2.5",
  "description": "DSH-native vision bridge for text-only models with native image attachments, multi-image evidence batching, and session-scoped validated Evidence caching.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwistedRiCen/dsh-vision-bridge.git"
  },
  "homepage": "https://github.com/TwistedRiCen/dsh-vision-bridge#readme",
  "bugs": {
    "url": "https://github.com/TwistedRiCen/dsh-vision-bridge/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:installer": "node scripts/installer/build.mjs",
    "test": "npm run build && node --test",
    "test:installer": "node scripts/installer/build.mjs && node --test \"tests/setup/*.test.mjs\"",
    "pack": "pnpm pack"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "undici": "7.29.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
